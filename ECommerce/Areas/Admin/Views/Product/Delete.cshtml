@model Product

<div class="container py-5">

    <div class="delete-page">

        <div class="delete-icon">
            <i class="bi bi-trash3"></i>
        </div>

        <span class="page-badge danger-badge">
            DELETE PRODUCT
        </span>

        <h1>Delete this product?</h1>

        <p class="delete-warning">
            This action cannot be undone. The following product
            will be permanently removed.
        </p>

        <div class="delete-product-card">

            <div class="product-icon">
                <i class="bi bi-box-seam"></i>
            </div>

            <div class="delete-product-info">

                <h3>@Model.Name</h3>

                <p>
                    @Model.Description
                </p>

                <strong>
                    $@Model.Price
                </strong>

            </div>

        </div>

        <form method="post">

            <input asp-for="Id" type="hidden" />

            <div class="delete-actions">

                <button type="submit"
                        class="btn btn-danger">
                    <i class="bi bi-trash3"></i>
                    Delete Product
                </button>

                <a asp-action="Index"
                   class="btn btn-light">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>