@model List<ECommerce.Models.ViewModels.OrderVM>

<div class="customer-page-header">

    <div>
        <span class="customer-badge">MY ORDERS</span>

        <h1>Order History</h1>

        <p>
            View your previous orders and track their status.
        </p>
    </div>

</div>


@if (!Model.Any())
{
    <div class="customer-table-card text-center p-5">

        <div class="mb-3">
            <i class="bi bi-bag-x fs-1 text-muted"></i>
        </div>

        <h3>No Orders Yet</h3>

        <p class="text-muted">
            You haven't placed any orders yet.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-primary">
            Start Shopping
        </a>

    </div>
}
else
{
    <div class="customer-table-card">

        <div class="table-responsive">

            <table class="customer-table order-history-table">

                <thead>
                    <tr>
                        <th>ORDER</th>
                        <th>DATE</th>
                        <th>TOTAL</th>
                        <th>STATUS</th>
                        <th class="text-end">ACTION</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var order in Model.OrderByDescending(o => o.OrderDate))
                    {
                        <tr>

                            <!-- Order -->
                            <td>
                                <strong class="order-number">
                                    #@order.Id
                                </strong>
                            </td>

                            <!-- Date -->
                            <td>
                                <div class="order-date">
                                    @order.OrderDate.ToString("dd/MM/yyyy")
                                </div>

                                <small class="text-muted">
                                    @order.OrderDate.ToString("hh:mm tt")
                                </small>
                            </td>

                            <!-- Total -->
                            <td>
                                <strong class="order-total">
                                    $@order.Total.ToString("N2")
                                </strong>
                            </td>

                            <!-- Status -->
                            <td>
                                @if (order.Status == ECommerce.Models.OrderStatus.Pending)
                                {
                                    <span class="order-status pending">
                                        <i class="bi bi-clock"></i>
                                        Pending
                                    </span>
                                }
                                else if (order.Status == ECommerce.Models.OrderStatus.Shipped)
                                {
                                    <span class="order-status shipped">
                                        <i class="bi bi-truck"></i>
                                        Shipped
                                    </span>
                                }
                                else if (order.Status == ECommerce.Models.OrderStatus.Completed)
                                {
                                    <span class="order-status completed">
                                        <i class="bi bi-check-circle"></i>
                                        Completed
                                    </span>
                                }
                                else if (order.Status == ECommerce.Models.OrderStatus.Cancelled)
                                {
                                    <span class="order-status cancelled">
                                        <i class="bi bi-x-circle"></i>
                                        Cancelled
                                    </span>
                                }
                                else if (order.Status == ECommerce.Models.OrderStatus.Processing)
                                {
                                    <span class="order-status processing">
                                        <i class="bi bi-hourglass-split"></i>
                                        Processing
                                    </span>
                                }
                            </td>

                            <!-- Action -->
<td class="text-end">

    <div class="order-actions">

        <a asp-area="Customer"
           asp-controller="Order"
           asp-action="Details"
           asp-route-id="@order.Id"
           class="order-details-btn">

            <i class="bi bi-eye"></i>
            View Details

        </a>

        @if (order.Status == ECommerce.Models.OrderStatus.Pending)
        {
            <form asp-area="Customer"
                  asp-controller="Order"
                  asp-action="Cancel"
                  asp-route-id="@order.Id"
                  method="post"
                  class="d-inline">

                <button type="submit"
                        class="order-cancel-btn"
                        onclick="return confirm('Are you sure you want to cancel this order?');">

                    <i class="bi bi-x-circle"></i>
                    Cancel

                </button>

            </form>
        }

    </div>

</td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}