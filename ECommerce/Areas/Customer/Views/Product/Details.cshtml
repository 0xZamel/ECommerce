@model ECommerce.Models.Product

<div class="container py-5">

    <div class="row g-5">

        <!-- Image -->
        <div class="col-md-6">

            <div class="product-details-image">

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         alt="@Model.Name"
                         class="img-fluid rounded" />
                }
                else
                {
                    <div class="product-image-placeholder">
                        <i class="bi bi-box-seam"></i>
                    </div>
                }

            </div>

        </div>


        <!-- Product Information -->
        <div class="col-md-6">

            @if (Model.Category != null)
            {
                <span class="text-primary fw-semibold">
                    @Model.Category.Name
                </span>
            }

            <h1 class="fw-bold mt-2">
                @Model.Name
            </h1>

            <h3 class="text-primary fw-bold mt-3">
                $@Model.Price.ToString("N2")
            </h3>

            <p class="text-muted mt-4">
                @Model.Description
            </p>


            <!-- Stock -->
            @if (Model.StockQuantity > 0)
            {
                <div class="text-success fw-semibold mb-4">
                    <i class="bi bi-check-circle me-1"></i>
                    @Model.StockQuantity in stock
                </div>
            }
            else
            {
                <div class="text-danger fw-semibold mb-4">
                    <i class="bi bi-x-circle me-1"></i>
                    Out of stock
                </div>
            }


            <!-- Cart -->
            @if (Model.StockQuantity > 0)
            {
                <form asp-area="Customer"
                      asp-controller="Cart"
                      asp-action="AddToCart"
                      method="post">

                    <input type="hidden"
                           name="productId"
                           value="@Model.Id" />

                    <button type="submit"
                            class="btn btn-primary btn-lg">

                        <i class="bi bi-cart-plus me-2"></i>
                        Add to Cart

                    </button>

                </form>
            }
            else
            {
                <button class="btn btn-secondary btn-lg"
                        disabled>
                    Out of Stock
                </button>
            }
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-area="Customer"
                      asp-controller="Wishlist"
                      asp-action="Add"
                      method="post"
                      class="d-inline">

                    <input type="hidden"
                           name="productId"
                           value="@Model.Id" />

                    <button type="submit"
                            class="btn btn-outline-danger btn-lg">

                        <i class="bi bi-heart me-2"></i>
                        Add to Wishlist

                    </button>

                </form>
            }

        </div>

    </div>


    <!-- Reviews -->
    <div class="mt-5 pt-5 border-top">

        <h2 class="fw-bold mb-4">
            Customer Reviews
        </h2>

        @if (Model.Reviews != null && Model.Reviews.Any())
        {
            foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">

                        <div class="d-flex justify-content-between">

                            <div>
                                <strong>
                                    @review.User?.FullName
                                </strong>

                                <div class="text-warning">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= review.Rating)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    }
                                </div>
                            </div>

                            <small class="text-muted">
                                @review.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                            </small>

                        </div>

                        <p class="mt-3 mb-0">
                            @review.Comment
                        </p>

                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted">
                No reviews yet. Be the first to review this product!
            </p>
        }


        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Write a Review
                    </h4>

                    <form asp-area="Customer"
                          asp-controller="Review"
                          asp-action="Create"
                          method="post">

                        <input type="hidden"
                               name="ProductId"
                               value="@Model.Id" />

                        <div class="mb-3">

                            <label class="form-label">
                                Rating
                            </label>

                            <select name="Rating"
                                    class="form-select"
                                    required>

                                <option value="">Select rating</option>
                                <option value="5">★★★★★ - 5</option>
                                <option value="4">★★★★☆ - 4</option>
                                <option value="3">★★★☆☆ - 3</option>
                                <option value="2">★★☆☆☆ - 2</option>
                                <option value="1">★☆☆☆☆ - 1</option>

                            </select>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Your Review
                            </label>

                            <textarea name="Comment"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Write your review..."
                                      required></textarea>

                        </div>

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-send me-2"></i>
                            Submit Review

                        </button>

                    </form>

                </div>
            </div>
        }
        else
        {
            <div class="alert alert-light mt-4">
                Please log in to write a review.
            </div>
        }

    </div>

</div>