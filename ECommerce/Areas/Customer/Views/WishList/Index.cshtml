@model IEnumerable<ECommerce.Models.Wishlist>

<div class="container py-5">

    <div class="text-center mb-5">

        <span class="page-badge">
            MY WISHLIST
        </span>

        <h1 class="fw-bold mt-2">
            My Wishlist
        </h1>

        <p class="text-muted">
            Products you saved for later.
        </p>

    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">

            <i class="bi bi-heart"
               style="font-size: 4rem;"></i>

            <h3 class="fw-bold mt-3">
                Your wishlist is empty
            </h3>

            <p class="text-muted">
                Save products you want to buy later.
            </p>

            <a asp-area="Customer"
               asp-controller="Product"
               asp-action="Index"
               class="btn btn-primary">

                Browse Products

            </a>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="card h-100 border-0 shadow-sm">

                        <div class="product-image-container">

                            @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                            {
                                <img src="@item.Product.ImageUrl"
                                     alt="@item.Product.Name"
                                     class="product-image" />
                            }
                            else
                            {
                                <div class="product-image-placeholder">
                                    <i class="bi bi-box-seam"></i>
                                </div>
                            }

                        </div>

                        <div class="card-body">

                            <h5 class="fw-bold">
                                @item.Product.Name
                            </h5>

                            <p class="text-muted">
                                @item.Product.Description
                            </p>

                            <h5 class="text-primary fw-bold">
                                $@item.Product.Price.ToString("N2")
                            </h5>

                            @if (item.Product.StockQuantity > 0)
                            {
                                <span class="text-success fw-semibold">
                                    <i class="bi bi-check-circle me-1"></i>
                                    @item.Product.StockQuantity in stock
                                </span>
                            }
                            else
                            {
                                <span class="text-danger fw-semibold">
                                    <i class="bi bi-x-circle me-1"></i>
                                    Out of stock
                                </span>
                            }

                            <div class="d-flex gap-2 mt-3">

                                @if (item.Product.StockQuantity > 0)
                                {
                                    <form asp-area="Customer"
                                          asp-controller="Wishlist"
                                          asp-action="MoveToCart"
                                          method="post"
                                          class="flex-grow-1">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="btn btn-primary w-100">

                                            <i class="bi bi-cart-plus me-1"></i>
                                            Add to Cart

                                        </button>

                                    </form>
                                }

                                <form asp-area="Customer"
                                      asp-controller="Wishlist"
                                      asp-action="Remove"
                                      method="post">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    <button type="submit"
                                            class="btn btn-outline-danger">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>