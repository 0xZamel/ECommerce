@using ECommerce.DataAccess.Repository.IRepository
@using ECommerce.Models
@using Microsoft.AspNetCore.Identity

@inject IUnitOfWork UnitOfWork
@inject UserManager<ApplicationUser> UserManager

@{
    var cartCount = 0;

    if (User.Identity?.IsAuthenticated == true)
    {
        var user = await UserManager.GetUserAsync(User);

        if (user != null)
        {
            var cart = UnitOfWork.Cart.Get(c => c.UserId == user.Id);

            if (cart != null)
            {
                cartCount = UnitOfWork.CartItem
                    .GetAll()
                    .Where(c => c.CartId == cart.Id)
                    .Sum(c => c.Quantity);
            }
        }
    }
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ECommerce</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ECommerce.styles.css" asp-append-version="true" />
    <link rel="stylesheet"href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ECommerce</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Customer" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Customer" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        @if (User.IsInRole("Customer"))
                        {
                            <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Customer" asp-controller="Product" asp-action="Index">Product</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Customer" asp-controller="Order" asp-action="Index">Orders</a>
                        </li>
                        <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Customer" asp-controller="WishList" asp-action="Index">WishList</a>
                        </li>

                        }
                        @if (User.IsInRole("Admin")) 
                        {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        MANGMENT
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li class="dropdown-item">
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="User" asp-action="Index">User</a>
                                        </li>
                                        <li class="dropdown-item">
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Role" asp-action="Index">Role</a>
                                        </li>
                                        <li class="dropdown-item">
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Product" asp-action="Index">Product</a>
                                        </li>
                                        <li class="dropdown-item">
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Order" asp-action="Index">Orders</a>
                                        </li>

                                        <li class="dropdown-item">
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Category" asp-action="Index">Categories</a>
                                        </li>
                                        <li class="dropdown-item">
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                                        </li>

                                        <li><hr class="dropdown-divider"></li>

                                    </ul>
                                </li>
                        }
                        </ul>
                            <li class="nav-item">
                                <a class="nav-link position-relative"
                                   asp-area="Customer"
                                   asp-controller="Cart"
                                   asp-action="Index">

                                    <i class="bi bi-cart3 fs-5"></i>

                                    @if (cartCount > 0)
                                    {
                                        <span class="cart-badge">
                                            @cartCount
                                        </span>
                                    }

                                </a>
                    </li>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ECommerce - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
